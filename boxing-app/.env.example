# Fightbase kostenloser Datenfeed – kein RapidAPI-Key nötig
FEED_REFRESH_MINUTES=360

# Admin-Bereich: Werte in der lokalen .env selbst ersetzen.
# Ein Passwort mit mindestens 10 Zeichen wählen.
FIGHTBASE_ADMIN_PASSWORD=
# Mit: python -c "import secrets; print(secrets.token_urlsafe(40))"
FIGHTBASE_SECRET_KEY=

# Optional: nur kostenlosen RapidAPI Basic-Tarif verwenden (100/Monat beim Anbieter).
# Fightbase selbst limitiert auf 30 Anfragen pro Monat.
BOXING_API_KEY=
BOXING_API_AUTO_SYNC=true
